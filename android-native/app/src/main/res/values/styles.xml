<resources>
    <style name="AppTheme.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_blue</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_surface</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="AppTheme" parent="AppTheme.Base" />
    <style name="AppTheme.Launch" parent="AppTheme">
        <item name="android:windowBackground">@drawable/window_launch</item>
    </style>
</resources>
